# Brewfile — developer tooling for a fresh macOS machine.
#
# Install / update everything (idempotent — re-run any time):
#   brew bundle --file=~/Brewfile
# or, while sitting in this repo:
#   brew bundle
#
# This is meant to grow over time. Add a line, re-run `brew bundle`, commit.

# --- Shell & prompt ---
brew "zsh"
brew "fzf"

# --- Languages & runtimes ---
brew "python"
brew "node"
brew "uv"
brew "go"

# --- CLI tooling ---
brew "git"
brew "just"
brew "tmux"
brew "vim"
brew "kubectl"
brew "kustomize"
brew "helm"
brew "opentofu"
brew "firebase-cli"
brew "ffmpeg"

# --- GUI dev tools ---
cask "gcloud-cli"        # gcloud; .zshrc also probes /opt/google-cloud-sdk
cask "visual-studio-code"
cask "docker-desktop"
cask "iterm2"
cask "font-meslo-lg-nerd-font"   # recommended glyph font for powerlevel10k

# --- GUI apps ---
cask "google-chrome"
cask "vlc"
cask "obs"
cask "whatsapp"
cask "zoom"

